new file mode 100644
index 0000000000000000000000000000000000000000..4fd1970b1d38ab59d8ccf727105ab16c7ede6c09
--- /dev/null
+++ b/server/migrations/006_add_gemini_ai_provider.sql
@@ -0,0 +1,18 @@
+-- Add Google Gemini as a supported OpenFamily AI provider.
+DO $$
+BEGIN
+    IF EXISTS (
+        SELECT 1
+        FROM pg_constraint
+        WHERE conname = 'ai_settings_provider_check'
+          AND pg_get_constraintdef(oid) NOT ILIKE '%gemini%'
+    ) THEN
+        ALTER TABLE ai_settings
+            DROP CONSTRAINT ai_settings_provider_check;
+
+        ALTER TABLE ai_settings
+            ADD CONSTRAINT ai_settings_provider_check
+            CHECK (provider IN ('ollama', 'openai', 'anthropic', 'gemini'));
+    END IF;
+END
+$$;
